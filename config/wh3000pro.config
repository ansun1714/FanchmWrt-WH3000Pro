CONFIG_TARGET_arm=y
CONFIG_TARGET_BOARD="mediatek"
CONFIG_TARGET_SUBTARGET="filogic"
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_huasifei_wh3000-pro-emmc=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic=""

CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=448
# LuCI
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# FanchmWrt / firewall
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-offload=y

# Wi-Fi / MT7981
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_mt7981-wo-firmware=y

# USB / storage / fan
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_mkf2fs=y

# QModem
CONFIG_PACKAGE_luci-app-qmodem-next=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_comgt=y
CONFIG_PACKAGE_chat=y
CONFIG_PACKAGE_libqmi=y
CONFIG_PACKAGE_qmi-utils=y
CONFIG_PACKAGE_libmbim=y
CONFIG_PACKAGE_mbim-utils=y
CONFIG_PACKAGE_modemmanager=y

# Network diagnostics
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_nano=y

# Lucky
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_lucky=y

# Docker
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
CONFIG_PACKAGE_tini=y
CONFIG_PACKAGE_docker=y

# Useful filesystem/network tools
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nf-conntrack=y

# IPv6
CONFIG_IPV6=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

# Build helpers
CONFIG_DEVEL=y
CONFIG_CCACHE=y

CONFIG_PACKAGE_msd_lite=y
CONFIG_PACKAGE_rtp2httpd=y
CONFIG_PACKAGE_luci-app-iptv-manager=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_luci-app-unicast-proxy=y

# Do not force a testing kernel.
# FanchmWrt 25.12.4 uses the MediaTek 6.12 configuration for Filogic.
# The WH3000 Pro eMMC device definition is supplied by FanchmWrt itself.

